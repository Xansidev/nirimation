self:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.nirimation;
  tomlFormat = pkgs.formats.toml { };

  animations = map (lib.removeSuffix ".kdl") (
    lib.filter (lib.hasSuffix ".kdl") (lib.attrNames (builtins.readDir ../animations))
  );

  animationParams = lib.optionalAttrs (cfg.animation != null) (cfg.settings.${cfg.animation} or { });

  # Build the active animation at build time, reusing the script's own
  # parameter patterns so the result matches `nirimation apply <name>`.
  activeKdl =
    pkgs.runCommand "nirimation-${cfg.animation}.kdl"
      {
        nativeBuildInputs = [ pkgs.python3 ];
        params = builtins.toJSON animationParams;
        passAsFile = [ "params" ];
      }
      ''
        cp ${cfg.package}/share/nirimation/${cfg.animation}.kdl $out
        chmod u+w $out
        HOME=$TMPDIR python3 - <<'PY'
        import importlib.machinery, importlib.util, json, os
        from pathlib import Path

        loader = importlib.machinery.SourceFileLoader("nirimation", "${cfg.package}/bin/nirimation")
        spec = importlib.util.spec_from_loader("nirimation", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)

        mod.ACTIVE_KDL = Path(os.environ["out"])
        params = json.loads(Path(os.environ["paramsPath"]).read_text())
        if params:
            mod.apply_params("${cfg.animation}", params)
        PY
      '';
in
{
  options.programs.nirimation = {
    enable = lib.mkEnableOption "nirimation, custom shader animations for niri";

    package = lib.mkOption {
      type = lib.types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.nirimation;
      defaultText = lib.literalExpression "nirimation.packages.\${system}.nirimation";
      description = "The nirimation package to use.";
    };

    animation = lib.mkOption {
      type = lib.types.nullOr (lib.types.enum animations);
      default = null;
      example = "glitch-cyberpunk";
      description = ''
        Animation to install declaratively as {file}`~/.config/niri/nirimation.kdl`,
        with any parameters from `settings.<animation>` applied.

        Add `include "nirimation.kdl"` to your niri config to use it.

        Leave this as `null` to manage animations imperatively with
        `nirimation apply <name>` instead.
      '';
    };

    settings = lib.mkOption {
      type = tomlFormat.type;
      default = { };
      example = lib.literalExpression ''
        {
          glitch-cyberpunk = {
            open_duration_ms = 500;
            rgb_split = 0.06;
          };
        }
      '';
      description = ''
        Configuration written to {file}`~/.config/nirimation/config.toml`.
        See `animations/config.toml` in the repository for available options.

        Setting this makes the file read-only, so `nirimation apply` will no
        longer be able to record the active animation.
      '';
    };

    kdl = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      readOnly = true;
      default = if cfg.animation != null then activeKdl else null;
      defaultText = lib.literalMD "the generated animation file, or `null`";
      description = ''
        The generated animation KDL file. Useful when your niri config is
        generated by Nix, e.g. `builtins.readFile config.programs.nirimation.kdl`.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = [ cfg.package ];

    programs.nirimation.settings = lib.mkIf (cfg.animation != null) {
      animation.active = lib.mkDefault cfg.animation;
    };

    xdg.configFile = {
      "nirimation/config.toml" = lib.mkIf (cfg.settings != { }) {
        source = tomlFormat.generate "nirimation-config.toml" cfg.settings;
      };
      "niri/nirimation.kdl" = lib.mkIf (cfg.animation != null) {
        source = activeKdl;
      };
    };
  };
}
